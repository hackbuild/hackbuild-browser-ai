{
  "name": "hackbuild-browser-ai-workspace",
  "private": true,
  "type": "module",
  "license": "MIT",
  "author": "Moheeb Zara <hackbuildvideo@gmail.com>",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": "^22.18.0 || >=24.11.0"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "build": "npm run build --workspaces --if-present && node tools/bundle.mjs",
    "test": "vitest run && node --test tools/test/*.test.mjs",
    "typecheck": "tsc -b && tsc -p examples",
    "lint:voice": "git ls-files | grep -Ev '\\.(png|jpe?g|glb|bin|wasm|wav)$|^(LICENSES/|RULES.md|CLAUDE.md|tools/)|package-lock.json|Cargo.lock' | xargs node tools/lint-voice.mjs",
    "bundle": "node tools/bundle.mjs",
    "examples": "node tools/build-pages.mjs",
    "examples:check": "node tools/check-examples.mjs",
    "build:wasm": "node tools/build-wasm.mjs --all",
    "lint:packages": "node tools/lint-packages.mjs",
    "release:dry": "node tools/lint-packages.mjs && node tools/release-plan.mjs",
    "ui:check": "node tools/vendor/pin-ui.mjs --check",
    "check:origin": "node tools/check-origin.mjs"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@changesets/cli": "3.0.3",
    "@types/node": "22.20.5",
    "@types/three": "0.186.0",
    "@virgilvox/hackbuild-ui": "file:tools/vendor/hackbuild-ui-0.7.0-825837f.tgz",
    "bellows-voice": "0.8.0",
    "bellowsjs": "0.5.0",
    "fake-indexeddb": "6.2.8",
    "publint": "0.3.25",
    "puppeteer-core": "25.18.1",
    "rolldown": "1.2.19",
    "three": "0.186.1",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  }
}
