{
  "name": "@hackbuild/character",
  "version": "0.1.1",
  "description": "Character Card V2 and V3 read and write as JSON, PNG text chunks and CHARX archives in a Rust wasm core, with a versioned profile extension for avatar, voice and action vocabulary, macros and lorebook matching.",
  "type": "module",
  "license": "MIT",
  "author": "Moheeb Zara <hackbuildvideo@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hackbuild/hackbuild-browser-ai.git",
    "directory": "packages/character"
  },
  "engines": {
    "node": "^22.18.0 || >=24.11.0"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./inline": {
      "types": "./dist/inline.d.ts",
      "import": "./dist/inline.js"
    },
    "./character.wasm": "./wasm/character.wasm"
  },
  "files": [
    "dist",
    "wasm/character.wasm",
    "how.ts",
    "README.md",
    "LICENSE"
  ],
  "unpkg": "./dist/single/index.iife.js",
  "jsdelivr": "./dist/single/index.iife.js",
  "scripts": {
    "build": "tsc -b",
    "build:wasm": "node ../../tools/build-wasm.mjs character character CHARACTER_WASM_BASE64"
  }
}
