{
  "name": "@hackbuild/ai-views",
  "version": "0.1.5",
  "description": "Views that bind the browser AI packages to hackbuild-ui: a model picker per job, a chat pane and composer, a drop first transcriber, a mask studio, a frame view and a camera feed. Each ships as a Vue component and a custom element.",
  "type": "module",
  "license": "MIT",
  "author": "Moheeb Zara <hackbuildvideo@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hackbuild/hackbuild-browser-ai.git",
    "directory": "packages/ai-views"
  },
  "engines": {
    "node": "^22.18.0 || >=24.11.0"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./elements": {
      "types": "./dist/elements.d.ts",
      "import": "./dist/elements.js"
    },
    "./vue": {
      "types": "./dist/vue.d.ts",
      "import": "./dist/vue.js"
    }
  },
  "files": [
    "dist",
    "how.ts",
    "README.md",
    "llms.md",
    "LICENSE"
  ],
  "unpkg": "./dist/single/elements.iife.js",
  "jsdelivr": "./dist/single/elements.iife.js",
  "scripts": {
    "build": "tsc -b"
  },
  "dependencies": {
    "@hackbuild/ai-env": "0.1.2",
    "@hackbuild/audio-dsp": "0.1.2",
    "@hackbuild/chat": "0.1.2",
    "@hackbuild/devices": "0.1.3",
    "@hackbuild/embed": "0.1.3",
    "@hackbuild/imagegen": "0.2.0",
    "@hackbuild/memory": "0.1.4",
    "@hackbuild/models": "0.2.2",
    "@hackbuild/speak": "0.1.3",
    "@hackbuild/transcribe": "0.1.3",
    "@hackbuild/vision": "0.2.0",
    "@hackbuild/weights": "0.1.2"
  },
  "peerDependencies": {
    "@virgilvox/hackbuild-ui": ">=0.10.0 <0.11.0",
    "vue": "^3.4.0"
  },
  "peerDependenciesMeta": {
    "vue": {
      "optional": true
    }
  }
}
