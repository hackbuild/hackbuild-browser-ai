{
  "name": "@hackbuild/biosignal",
  "version": "0.1.2",
  "description": "EEG in a tab: zero phase filters, shrunk covariances and a Riemannian tangent space classifier with leak free grouped cross validation in a Rust wasm core (simd128), epoching, model export and an EEGNet runner slot.",
  "type": "module",
  "license": "MIT",
  "author": "Moheeb Zara <hackbuildvideo@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hackbuild/hackbuild-browser-ai.git",
    "directory": "packages/biosignal"
  },
  "engines": {
    "node": "^22.18.0 || >=24.11.0"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./inline": {
      "types": "./dist/inline.d.ts",
      "import": "./dist/inline.js"
    },
    "./biosignal.wasm": "./wasm/biosignal.wasm"
  },
  "files": [
    "dist",
    "wasm/biosignal.wasm",
    "how.ts",
    "README.md",
    "llms.md",
    "LICENSE"
  ],
  "unpkg": "./dist/single/index.iife.js",
  "jsdelivr": "./dist/single/index.iife.js",
  "scripts": {
    "build": "tsc -b",
    "build:wasm": "node ../../tools/build-wasm.mjs biosignal biosignal BIOSIGNAL_WASM_BASE64"
  }
}
