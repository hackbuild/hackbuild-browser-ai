{
  "name": "@hackbuild/audio-dsp",
  "version": "0.1.1",
  "description": "Speech and music DSP in a Rust wasm core (simd128): biquads, dc block, frame levels, noise floor, VAD gate, spectral subtraction, limiter, resampling, STFT, onsets, tempo and grid fit; with WAV, MIDI, srt, vtt, lrc and zip writers and an overlap add planner in TS.",
  "type": "module",
  "license": "MIT",
  "author": "Moheeb Zara <hackbuildvideo@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hackbuild/hackbuild-browser-ai.git",
    "directory": "packages/audio-dsp"
  },
  "engines": {
    "node": "^22.18.0 || >=24.11.0"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./inline": {
      "types": "./dist/inline.d.ts",
      "import": "./dist/inline.js"
    },
    "./audio-dsp.wasm": "./wasm/audio-dsp.wasm"
  },
  "files": [
    "dist",
    "wasm/audio-dsp.wasm",
    "how.ts",
    "README.md",
    "LICENSE"
  ],
  "unpkg": "./dist/single/index.iife.js",
  "jsdelivr": "./dist/single/index.iife.js",
  "scripts": {
    "build": "tsc -b",
    "build:wasm": "node ../../tools/build-wasm.mjs audio-dsp audio-dsp AUDIO_DSP_WASM_BASE64"
  }
}
